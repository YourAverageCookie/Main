-- Drag Detector Logic
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not DragDetectorEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        IsMouseDown = true
        local target = Mouse.Target
        if target and target:IsA("BasePart") then
            DraggedPart = target
            DraggedPartStartPos = target.Position
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        IsMouseDown = false
        if DraggedPart and DragDetectorEnabled then
            local endPos = DraggedPart.Position
            local distance = (endPos - DraggedPartStartPos).Magnitude
            if distance > 1 then
                notify("Drag Detected!", "Part '" .. DraggedPart.Name .. "' was dragged " .. math.floor(distance) .. " studs!", 5)
            end
        end
        DraggedPart = nil
        DraggedPartStartPos = nil
    end
end)

